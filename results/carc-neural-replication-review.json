  "findings": [
    "Reaction-clock covers all 27 diagnostic parents in each seed but joint transient passes are 6/6/5, all in the baseline regime.",
    "FNO-split joint transient passes are 9/10/9; it remains the mandatory transient control. No learned family passes a boundary parent jointly.",
    "Reaction-clock loses all 36 mixed-frequency rollout-error comparisons against selected generic MLP in every seed. Seed74011 generic is the split-equivalent initialization; seeds74021/74031 select step8.",
    "Clock median CPU speedups versus selected generic MLP are only 1.051-1.060; versus FNO-split 2.219-2.222. Ratios compare post-hoc fastest feasible steps, not equal-step deployment.",
    "Six CNN seed74031 rollout decisions pass on CARC and fail in cloud; parent coverage and all heldout pass decisions remain unchanged.",
    "Clock wins against the best tested classical frontier on 0/27, 0/27, 1/27 parents by seed; no reproducible broad classical advantage."
  ],
  "next_architecture_hypothesis": {
    "priority": "Test a compact bounded state correction before the final exact reaction against unchanged reaction-clock; retain generic MLP and FNO-split controls.",
    "mechanism": "For an initial zero cell with intermediate w=O(h), an O(h^3) clock shift produces O(h^4) state change; a pre-reaction capacity correction can supply O(h^3) when directional capacity is sufficiently large.",
    "second_stage": "Compare horizon-independent spectral and parameter-matched pointwise encoders to isolate spatial context from parameter count; separate matched clock/capacity decoders.",
    "primary_endpoint": "Joint transient parent acceptance by regime/state class, with full-rollout coverage and smooth-case regressions reported separately.",
    "controls_and_limits": "Fresh diagnostic parents, validation-only selection, paired seeds, freeze all models before diagnostics, fixed tolerance/update/time budgets. No automatic larger campaign.",
    "risks": [
      "Existing local commuting gate may suppress finite-time nonlocal corrections in flat patches.",
      "Small directional capacity can change the leading defect coefficient.",
      "Invariant bounds do not prove nonlinear stability.",
      "Spectral encoder overhead may remove speed gains.",
      "Established components; worldwide novelty and superiority are unproven."
    ]
  },
  "limits": [
    "27 distinct diagnostic parents are shared across training seeds, not 81 independent parents.",
    "96-update local neural adaptations do not establish convergence or published benchmark parity.",
    "CPU timings do not establish A100 performance.",
    "Completed pipeline and report validation do not establish scientific superiority."
  ]
}
